# Development only. Do not commit credentials. Migration and application URLs must use separate roles.
DATABASE_URL="postgresql://migration_user:replace-me@localhost:5432/campusconnect?schema=public"

# Separate auth-only role; provision outside source control.
AUTH_DATABASE_URL="postgresql://campusconnect_auth:replace-me@localhost:5432/campusconnect_dev"
AUTH_RATE_LIMIT_SECRET="replace-with-64-hexadecimal-characters"
# Exact public origin. HTTPS is required in production.
APP_ORIGIN="http://localhost:3000"
